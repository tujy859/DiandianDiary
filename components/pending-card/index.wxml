<view class="pcard jd-card status-{{draft.status}}">
  <!-- 头部状态：精致微光徽章 -->
  <view class="pcard-head">
    <block wx:if="{{saveState.busy}}">
      <view class="pcard-progress" aria-role="status"><view class="save-spinner"></view><text>{{saveState.label || '正在保存日记…'}}</text></view>
    </block>
    <block wx:elif="{{draft.status === 'pending'}}">
      <view class="pcard-badge is-pending">
        <text class="badge-sparkle">✦</text>
        <text>待确认日记</text>
      </view>
    </block>
    <block wx:elif="{{draft.status === 'saved'}}">
      <view class="pcard-badge is-saved">
        <t-icon name="check" size="26rpx" color="#256145" />
        <text>已记入时光册</text>
      </view>
      <view class="pcard-link" bindtap="onView">
        <text>查看日记</text>
        <t-icon name="chevron-right" size="26rpx" color="#256145" />
      </view>
    </block>
    <block wx:elif="{{draft.status === 'failed'}}">
      <view class="pcard-badge is-failed">
        <t-icon name="close" size="26rpx" color="#D54941" />
        <text>保存未完成</text>
      </view>
      <text class="pcard-title">草稿已保留</text>
    </block>
    <block wx:else>
      <view class="pcard-badge is-discarded">
        <text>已取消记录</text>
      </view>
    </block>
  </view>

  <view wx:if="{{!saveState.busy && draft.status === 'failed' && saveState.detail}}" class="save-feedback is-failed" aria-role="status">
    <view class="save-label">{{saveState.label}}</view>
    <view class="save-detail">{{saveState.detail}}</view>
  </view>

  <view class="pcard-body {{draft.status === 'discarded' ? 'is-muted' : ''}}">
    <view class="pcard-meta">
      <text class="pcard-pet-name">{{petName}}</text>
      <text class="pcard-meta-dot">·</text>
      <text wx:if="{{draft.date}}" class="pcard-date">{{dateText}}</text>
      <text wx:else class="pcard-date-placeholder">日期待补充</text>
    </view>
    <view wx:if="{{!draft.date}}" class="pcard-chips">
      <text
        wx:for="{{chips}}"
        wx:key="value"
        class="pcard-chip"
        data-value="{{item.value}}"
        catchtap="onChip"
      >{{item.label}}</text>
      <text class="pcard-chip is-more" catchtap="onEdit">选择日期</text>
    </view>

    <!-- 记录正文 -->
    <view wx:if="{{draft.text}}" class="pcard-text">{{draft.text}}</view>

    <!-- 标签 -->
    <view wx:if="{{draft.tags.length}}" class="pcard-tags">
      <view wx:for="{{draft.tags}}" wx:key="*this" class="pcard-tag-pill">{{item}}</view>
    </view>

    <!-- 照片 -->
    <view wx:if="{{draft.photos.length}}" class="pcard-photos">
      <image
        wx:for="{{draft.photos}}"
        wx:key="*this"
        class="pcard-photo"
        src="{{item}}"
        mode="aspectFill"
        data-index="{{index}}"
        bindtap="onPreview"
      />
    </view>
  </view>

  <!-- 底部操作按钮 -->
  <view wx:if="{{saveState.busy || draft.status === 'pending'}}" class="pcard-actions {{saveState.busy ? 'is-busy' : ''}}">
    <view class="pcard-btn is-primary" bindtap="onSave" aria-role="button" aria-disabled="{{saveState.busy}}">
      <view wx:if="{{saveState.busy}}" class="save-spinner is-button"></view>
      <text>{{saveState.busy ? '保存中' : '保存这条'}}</text>
    </view>
    <view class="pcard-btn is-outline" bindtap="onEdit" aria-role="button" aria-disabled="{{saveState.busy}}">
      <text>修改</text>
    </view>
    <view class="pcard-btn is-ghost" bindtap="onDiscard" aria-role="button" aria-disabled="{{saveState.busy}}">
      <text>不记录</text>
    </view>
  </view>
  <view wx:elif="{{!saveState.busy && draft.status === 'failed'}}" class="pcard-actions">
    <view class="pcard-btn is-primary" bindtap="onSave">{{saveState.stage === 'refresh' ? '确认保存结果' : '重试保存'}}</view>
    <view wx:if="{{saveState.stage !== 'refresh'}}" class="pcard-btn is-ghost" bindtap="onDiscard">不记录</view>
  </view>
</view>

