.pcard {
  padding: 28rpx;
  margin: 16rpx 0;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(47, 107, 79, 0.03);
  border: 1rpx solid rgba(240, 236, 228, 0.85);
  position: relative;
  overflow: hidden;
}

/* 顶部状态条 */
.pcard-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.pcard-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
}

.pcard-badge.is-pending {
  background: linear-gradient(135deg, #fff7eb 0%, #ffeed4 100%);
  color: #c4771e;
  border: 1rpx solid rgba(242, 166, 90, 0.3);
}

.badge-sparkle {
  font-size: 20rpx;
  color: #f2a65a;
}

.pcard-badge.is-saved {
  background: #eaf4ee;
  color: #256145;
  border: 1rpx solid rgba(47, 107, 79, 0.2);
}

.pcard-badge.is-failed {
  background: #fdf0ef;
  color: #d54941;
  border: 1rpx solid rgba(213, 73, 65, 0.2);
}

.pcard-badge.is-discarded {
  background: #f4f5f4;
  color: #8a948e;
}

.pcard-title {
  font-size: 22rpx;
  color: #8f9b94;
}

.save-feedback { margin-bottom:20rpx; padding:20rpx; border-radius:16rpx; background:#f0f6f1; color:#256145; }
.save-feedback.is-failed { background:#fdf3f1; color:#a7443e; }
.save-label { font-size:25rpx; font-weight:600; line-height:1.5; }
.save-detail { margin-top:8rpx; font-size:23rpx; line-height:1.6; overflow-wrap:anywhere; }
.save-spinner { width:22rpx; height:22rpx; border:3rpx solid #cce2d6; border-top-color:#256145; border-radius:50%; animation:save-spin 0.9s linear infinite; }
@keyframes save-spin { to { transform:rotate(360deg); } }

.pcard-link {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: #256145;
  font-weight: 600;
}

.pcard-body.is-muted {
  opacity: 0.5;
}

/* 元信息卡片底板 */
.pcard-meta-box {
  background: #f9f7f2;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.pcard-meta-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.pcard-meta-row:last-child {
  margin-bottom: 0;
}

.meta-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 23rpx;
  color: #84938b;
  width: 120rpx;
  flex-shrink: 0;
}

.meta-value {
  font-size: 25rpx;
  color: #283730;
  font-weight: 500;
}
.meta-icon { width:26rpx; height:26rpx; flex-shrink:0; }

.meta-value.is-date {
  color: #256145;
  font-weight: 600;
}

.pcard-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.pcard-chip {
  font-size: 22rpx;
  color: #256145;
  background: #ffffff;
  border: 1rpx solid #cce2d6;
  border-radius: 20rpx;
  padding: 4rpx 18rpx;
}

.pcard-chip.is-more {
  background: transparent;
  border-style: dashed;
  color: #84938b;
}

/* 记录文本 */
.pcard-text {
  font-size: 28rpx;
  line-height: 1.65;
  color: #26362e;
  margin: 14rpx 0 10rpx;
  word-break: break-all;
}

/* 标签药丸 */
.pcard-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.pcard-tag-pill {
  font-size: 22rpx;
  color: #2d6b4f;
  background: #eaf4ee;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

/* 照片网格 */
.pcard-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.pcard-photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 18rpx;
  background: #f2eee6;
}

/* 底部操作按钮：高级胶囊组 */
.pcard-actions {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(240, 236, 228, 0.8);
  gap: 16rpx;
}

.pcard-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  padding: 0 32rpx;
  border-radius: 34rpx;
  font-size: 26rpx;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.pcard-btn:active {
  transform: scale(0.96);
  opacity: 0.88;
}

.pcard-btn.is-primary {
  background: linear-gradient(135deg, #357a57 0%, #22593e 100%);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(47, 107, 79, 0.25);
  flex: 1.2;
}

.pcard-btn.is-outline {
  background: #eaf4ee;
  color: #256145;
  font-weight: 500;
  flex: 1;
}

.pcard-btn.is-ghost {
  color: #8a968f;
  padding: 0 20rpx;
  font-size: 24rpx;
}
