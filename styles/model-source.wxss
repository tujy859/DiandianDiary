/* templates/model-form.wxml 的完整共享样式，页面仅保留各自的步骤与动作。 */
.model-head { display:flex; align-items:center; gap:24rpx; padding:8rpx 0 16rpx; }
.model-brand { width:104rpx; height:104rpx; border-radius:30rpx; flex-shrink:0; }
.model-title { font-size:var(--jd-fs-xl); font-weight:600; color:var(--jd-text-1); }
.model-sub { font-size:var(--jd-fs-sm); color:var(--jd-text-2); margin-top:4rpx; line-height:1.7; }
.label { font-size:var(--jd-fs-sm); font-weight:600; color:var(--jd-text-2); margin:32rpx 8rpx 16rpx; }
.provider-row { display:flex; gap:16rpx; flex-wrap:wrap; }
.provider-chip { font-size:var(--jd-fs-sm); padding:12rpx 34rpx; border-radius:999rpx; background:#ffffff; border:1rpx solid var(--jd-line); color:var(--jd-text-1); }
.provider-chip:active { transform:scale(0.97); }
.provider-chip.is-active { background:var(--jd-brand); color:#ffffff; border-color:var(--jd-brand); font-weight:600; }
.default-link { margin-top:24rpx; text-align:center; font-size:var(--jd-fs-sm); color:var(--jd-brand-deep); }
.privacy-note { font-size:var(--jd-fs-xs); color:var(--jd-text-2); line-height:1.7; margin:24rpx 8rpx 0; }

/* 来源选择：等宽双卡片，选中态品牌绿描边 */
.source-row {
  display: flex;
  gap: 16rpx;
}

.source-card {
  flex: 1;
  min-width: 0;
  padding: 24rpx 20rpx;
  border-radius: var(--jd-r-md);
  background: #ffffff;
  border: 1rpx solid var(--jd-line);
  transition: transform 0.15s ease, border-color 0.15s ease;
}

.source-card:active {
  transform: scale(0.98);
}

.source-card.is-active {
  border-color: var(--jd-brand);
  background: var(--jd-tint);
}

.source-name {
  font-size: var(--jd-fs-sm);
  font-weight: 600;
  color: var(--jd-text-1);
}

.source-desc {
  font-size: var(--jd-fs-xs);
  color: var(--jd-text-2);
  margin-top: 6rpx;
  line-height: 1.5;
}

.model-panel { margin-top:32rpx; padding:8rpx 24rpx; }
.model-field + .model-field { border-top:1rpx solid var(--jd-line); }

.cloud-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  box-sizing: border-box;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--jd-line);
}

.cloud-row:last-child {
  border-bottom: none;
}

.cloud-key {
  width: 132rpx;
  margin-right:20rpx;
  flex-shrink: 0;
  font-size: var(--jd-fs-sm);
  color: var(--jd-text-2);
}

.cloud-val {
  flex: 1;
  min-width:0;
  font-size: var(--jd-fs-sm);
  color: var(--jd-text-1);
  font-weight: 500;
}
