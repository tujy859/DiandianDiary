.tabbar { position:fixed; left:0; right:0; bottom:0; display:flex; height:112rpx; background:#ffffff; border-top:1rpx solid #e9ece6; z-index:99; box-sizing:border-box; }
.tabbar-item { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:8rpx 0; }
.tabbar-icon { display:flex; align-items:center; justify-content:center; padding:4rpx 28rpx; border-radius:24rpx; }
.tabbar-item.is-active .tabbar-icon { background:#edf3ee; }
.tabbar-text { color:#78837b; font-size:22rpx; margin-top:2rpx; }
.tabbar-item.is-active .tabbar-text { color:#32694f; font-weight:600; }
