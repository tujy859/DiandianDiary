.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: 120rpx;
  background: #ffffff;
  border-top: 1rpx solid #eee6da;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 99;
}

.tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0 8rpx;
}

.tabbar-text {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9ba5a0;
}

.tabbar-item.is-active .tabbar-text {
  color: #2f6b4f;
  font-weight: 600;
}

/* 中间圆形「聊聊」按钮 */
.tabbar-center {
  position: relative;
}

.center-btn {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #2f6b4f;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: -40rpx;
  border: 8rpx solid #faf7f0;
  box-shadow: 0 6rpx 16rpx rgba(47, 107, 79, 0.3);
}

.tabbar-center.is-active .center-btn {
  background: #3d8264;
}
