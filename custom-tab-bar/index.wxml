<view wx:if="{{!hidden}}" class="tabbar" style="height: {{tabHeightStyle}}; padding-bottom: {{bottomPadding}}px;">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tabbar-item {{selected === index ? 'is-active' : ''}}"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="onSwitch"
    aria-role="button"
    aria-label="{{item.text}}"
  >
    <view class="tabbar-icon"><t-icon name="{{item.icon}}" size="48rpx" color="{{selected === index ? '#32694F' : '#78837B'}}" /></view>
    <text class="tabbar-text">{{item.text}}</text>
  </view>
</view>
