<view wx:if="{{!hidden}}" class="tabbar" style="{{tabHeightStyle}} padding-bottom: {{safeBottom}}px;">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tabbar-item {{selected === index ? 'is-active' : ''}}"
    data-path="{{item.pagePath}}"
    data-index="{{index}}"
    bindtap="onSwitch"
  >
    <view class="tabbar-icon"><t-icon name="{{item.icon}}" size="42rpx" color="{{selected === index ? '#32694F' : '#78837B'}}" /></view>
    <text class="tabbar-text">{{item.text}}</text>
  </view>
</view>
