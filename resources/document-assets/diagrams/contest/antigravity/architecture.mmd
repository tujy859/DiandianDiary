    classDef cacheNode fill:#FAF8F3,stroke:#436854,stroke-width:1.5px,color:#253D31,font-size:12.5px;
    classDef cloudNode fill:#FAF8F3,stroke:#2F6048,stroke-width:1.5px,color:#1D382A,font-size:12.5px;

    class M1 modelNode;
    class UI,AG,TOOLS,VAL clientNode;
    class C1 cacheNode;
    class API,DB cloudNode;
