<view class="page" style="padding-bottom: {{tabbarHeight}}px;">
  <offline-bar />
  <test-space-bar />
  <!-- 品牌小猫与用户宠物头像分开 -->
  <view class="brand">
    <view class="brand-avatar">
      <image class="brand-image" src="/assets/brand/app-icon.png" mode="aspectFit" />
    </view>
    <view class="brand-copy"><view class="brand-name">记一下喵</view><view class="brand-slogan">记下和小家伙的每一天</view></view>
  </view>

  <!-- 宠物档案 -->
  <view class="section-heading"><view class="section-title">宠物档案</view><view wx:if="{{canManagePets}}" class="section-add" bindtap="onAddPet" aria-role="button"><t-icon name="add" size="28rpx" color="#32694F" /><text>添加宠物</text></view></view>
  <view class="jd-card panel">
    <view wx:if="{{!pets.length}}" class="panel-empty">
      <view>还没有小伙伴</view>
      <view class="panel-empty-sub">名字和物种，就能开启陪伴记录</view>
      <t-button wx:if="{{canManagePets}}" theme="primary" size="medium" shape="round" bindtap="onAddPet">添加宠物</t-button>
    </view>
    <view wx:for="{{pets}}" wx:key="id" class="pet-row" data-id="{{item.id}}" bindtap="onEditPet">
      <image class="pet-avatar" src="{{item.avatar}}" mode="aspectFit" />
      <view class="pet-info">
        <text class="pet-name">{{item.name}}</text>
        <text class="pet-sub">{{item.species}}{{item.breed ? ' · ' + item.breed : ''}}{{item.birthdayText ? ' · ' + item.birthdayText + ' 出生' : ''}}</text>
      </view>
      <t-icon wx:if="{{canManagePets}}" name="chevron-right" size="30rpx" color="#A4ACA5" />
    </view>
  </view>

  <view wx:if="{{!canManagePets}}" class="panel-empty-sub">宠物档案由家庭创建者管理</view>

  <!-- 设置 -->
  <view class="section-title">设置</view>
  <view class="jd-card panel">
    <view class="cell" bindtap="goFamily">
      <view class="cell-left"><t-icon name="usergroup" size="36rpx" color="#2F6B4F" /><text class="cell-text">账号与家庭空间</text></view>
      <view class="cell-right"><text class="cell-note">{{cloudOn ? '已连接云端' : '未连接'}}</text><t-icon name="chevron-right" size="32rpx" color="#C9CFCC" /></view>
    </view>
    <view class="cell" bindtap="goModel">
      <view class="cell-left">
        <t-icon name="setting" size="36rpx" color="#2F6B4F" />
        <text class="cell-text">模型连接配置</text>
      </view>
      <view class="cell-right">
        <text class="cell-note">{{modelNote}}</text>
        <t-icon name="chevron-right" size="32rpx" color="#C9CFCC" />
      </view>
    </view>
    <view class="cell" bindtap="onAbout">
      <view class="cell-left">
        <t-icon name="info-circle" size="36rpx" color="#2F6B4F" />
        <text class="cell-text">关于记一下喵</text>
      </view>
      <t-icon name="chevron-right" size="32rpx" color="#C9CFCC" />
    </view>
    <view class="cell" bindtap="onClear">
      <view class="cell-left">
        <t-icon name="delete" size="36rpx" color="#D54941" />
        <text class="cell-text is-danger">{{cloudOn ? '清除本机缓存' : '清除本机数据'}}</text>
      </view>
      <t-icon name="chevron-right" size="32rpx" color="#C9CFCC" />
    </view>
  </view>

  <!-- 宠物表单弹层 -->
  <block wx:if="{{devMode}}">
    <view class="section-title">开发者工具</view>
    <view class="jd-card panel">
      <view class="cell" bindtap="goSelftest">
        <view class="cell-left"><t-icon name="check-circle" size="36rpx" color="#32694F" /><text class="cell-text">开发测试</text></view>
        <view class="cell-right"><t-icon name="chevron-right" size="32rpx" color="#C9CFCC" /></view>
      </view>
      <view class="cell" bindtap="onDisableDeveloperMode" aria-role="button">
        <view class="cell-left"><t-icon name="close-circle" size="36rpx" color="#78837B" /><text class="cell-text">关闭开发者模式</text></view>
        <view class="cell-right"><t-icon name="chevron-right" size="32rpx" color="#C9CFCC" /></view>
      </view>
    </view>
  </block>
  <view class="brand-footnote">每一天，都有一点值得记住</view>
  <t-popup id="pet-form" visible="{{formVisible}}" placement="bottom" bind:visible-change="onFormClose">
    <scroll-view scroll-y class="form-scroll">
    <view class="form">
      <view class="form-head">
        <text class="form-title">{{form.id ? '编辑宠物' : '添加宠物'}}</text>
        <t-icon name="close" size="40rpx" color="#8A948E" bindtap="onFormClose" />
      </view>

      <t-input label="名字" placeholder="必填，比如：咪咪" value="{{form.name}}" bind:change="onNameInput" />

      <view class="form-label">物种（必选）</view>
      <view class="species-row">
        <view
          wx:for="{{speciesOptions}}"
          wx:key="*this"
          class="species-chip {{form.species === item ? 'is-active' : ''}}"
          data-value="{{item}}"
          bindtap="onSelectSpecies"
        >{{item}}</view>
      </view>

      <view class="form-label">选择头像</view>
      <view class="avatar-options">
        <view wx:for="{{avatarChoices}}" wx:key="id" class="avatar-option {{form.avatarId === item.id ? 'is-selected' : ''}}" data-id="{{item.id}}" bindtap="onSelectAvatar" aria-role="button" aria-label="{{item.label}}" aria-pressed="{{form.avatarId === item.id}}">
          <image src="{{item.src}}" mode="aspectFit" /><text>{{item.label}}</text>
          <view wx:if="{{form.avatarId === item.id}}" class="avatar-check"><t-icon name="check" size="22rpx" color="#FFFFFF" /></view>
        </view>
      </view>

      <t-input label="品种" placeholder="选填，以后补也可以" value="{{form.breed}}" bind:change="onBreedInput" />

      <view class="form-label">生日（选填）</view>
      <view class="birthday-row" bindtap="onOpenBirthday">
        <t-icon name="calendar" size="36rpx" color="#2F6B4F" />
        <text class="{{birthdayText ? 'birthday-value' : 'birthday-placeholder'}}">{{birthdayText || '以后补也可以'}}</text>
        <t-icon name="chevron-down" size="32rpx" color="#8A948E" />
      </view>

      <view wx:if="{{formError}}" class="form-error">{{formError}}</view>

      <t-button id="pet-save" theme="primary" size="large" block shape="round" bind:tap="onSavePet">保存</t-button>
      <view wx:if="{{form.id}}" class="delete-pet" data-id="{{form.id}}" bindtap="onDeletePet" aria-role="button"><t-icon name="delete" size="28rpx" color="#C45148" /><text>删除宠物档案</text></view>
    </view>
    </scroll-view>
  </t-popup>

  <t-date-time-picker
    visible="{{dateVisible}}"
    mode="date"
    title="生日"
    value="{{dateValue}}"
    bind:change="onBirthdayConfirm"
    bind:cancel="onBirthdayCancel"
  />

  <t-dialog id="t-dialog" />
  <t-toast id="t-toast" />
</view>
