.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 0;
  box-sizing: border-box;
  background: #faf7f0;
}

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 16rpx;
}

.brand-avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  background: var(--jd-tint);
  border: 4rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(47, 107, 79, 0.12);
}

.brand-name {
  margin-top: 16rpx;
  font-size: var(--jd-fs-xl);
  font-weight: 700;
  color: var(--jd-text-1);
}

.brand-slogan {
  margin-top: 6rpx;
  font-size: var(--jd-fs-sm);
  color: var(--jd-text-2);
}

.section-title {
  font-size: var(--jd-fs-sm);
  font-weight: 600;
  color: var(--jd-text-2);
  margin: 40rpx 8rpx 16rpx;
}

.panel {
  padding: 8rpx 24rpx;
}

.panel-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: var(--jd-fs-sm);
  color: var(--jd-text-2);
}

.pet-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--jd-line);
}

.pet-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--jd-tint);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.pet-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
}

.pet-name {
  font-size: var(--jd-fs-lg);
  font-weight: 600;
  color: var(--jd-text-1);
}

.pet-sub {
  font-size: var(--jd-fs-sm);
  color: var(--jd-text-2);
  margin-top: 4rpx;
}

.pet-del {
  padding: 12rpx;
}

.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 28rpx 0;
  font-size: var(--jd-fs-md);
  color: var(--jd-brand);
  font-weight: 600;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--jd-line);
}

.cell:last-child {
  border-bottom: none;
}

.cell-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cell-text {
  font-size: var(--jd-fs-md);
  color: var(--jd-text-1);
}

.cell-text.is-danger {
  color: #d54941;
}

.cell-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.cell-note {
  font-size: var(--jd-fs-xs);
  color: var(--jd-text-3);
}

/* 表单弹层 */
.form {
  background: #faf7f0;
  border-radius: var(--jd-r-lg) var(--jd-r-lg) 0 0;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.form-title {
  font-size: var(--jd-fs-xl);
  font-weight: 600;
  color: var(--jd-text-1);
}

.form-label {
  font-size: var(--jd-fs-sm);
  color: var(--jd-text-2);
  margin: 24rpx 0 12rpx;
}

.species-row {
  display: flex;
  gap: 16rpx;
}

.species-chip {
  font-size: var(--jd-fs-sm);
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid var(--jd-line);
  color: var(--jd-text-1);
}

.species-chip.is-active {
  background: var(--jd-brand);
  color: #ffffff;
  border-color: var(--jd-brand);
  font-weight: 600;
}

.birthday-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #ffffff;
  border-radius: var(--jd-r-sm);
  padding: 20rpx 24rpx;
}

.birthday-value {
  flex: 1;
  font-size: var(--jd-fs-md);
  color: var(--jd-text-1);
}

.birthday-placeholder {
  flex: 1;
  font-size: var(--jd-fs-md);
  color: var(--jd-text-3);
}

.form-error {
  color: #d54941;
  font-size: var(--jd-fs-sm);
  margin-top: 20rpx;
}

.form .t-button {
  margin-top: 32rpx;
}

.form .t-input {
  border-radius: var(--jd-r-sm);
  margin-top: 12rpx;
}
