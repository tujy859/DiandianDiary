<import src="../../templates/model-form.wxml" />
<view class="page">
  <template is="model-form" data="{{source, providers, form, inputStyle, cloudModel, cloudSupported, minSdk, recommendedModel, modelHelp, locked: testing}}" />

  <view class="connection-note">{{connectionNote}}</view>
  <view class="secondary-action"><t-button theme="default" size="large" block shape="round" variant="outline" loading="{{testing}}" disabled="{{testing}}" bind:tap="onTest">测试连接</t-button></view>
  <view class="primary-action"><t-button theme="primary" size="large" block shape="round" disabled="{{testing}}" bind:tap="onSave">保存配置</t-button></view>
  <view class="clear-action"><t-button theme="danger" size="small" variant="text" disabled="{{testing}}" bind:tap="onClear">清除模型配置</t-button></view>
</view>

<t-toast id="t-toast" />
<t-dialog id="t-dialog" />
