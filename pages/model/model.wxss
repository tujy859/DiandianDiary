/* 模型配置页：字号/字色/圆角/线色全部走 app.wxss 设计令牌 */
.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 提示横幅：暖杏警示面，圆角与字号对齐令牌 */
.banner {
  display: flex;
  gap: 12rpx;
  background: #fdf0dd;
  border-radius: var(--jd-r-sm);
  padding: 20rpx 24rpx;
  font-size: var(--jd-fs-sm);
  color: #8a6d3b;
  line-height: 1.6;
}

.label {
  font-size: var(--jd-fs-sm);
  font-weight: 600;
  color: var(--jd-text-2);
  margin: 32rpx 8rpx 16rpx;
}

.provider-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

/* 供应商选择：全圆胶囊，选中态品牌绿 */
.provider-chip {
  font-size: var(--jd-fs-sm);
  padding: 12rpx 34rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid var(--jd-line);
  color: var(--jd-text-1);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.provider-chip:active {
  transform: scale(0.97);
}

.provider-chip.is-active {
  background: var(--jd-brand);
  color: #ffffff;
  border-color: var(--jd-brand);
  font-weight: 600;
}

.panel {
  margin-top: 32rpx;
  padding: 12rpx 24rpx;
}

.panel .t-input {
  border-radius: var(--jd-r-sm);
  margin: 12rpx 0;
}

.default-link {
  margin-top: 24rpx;
  text-align: center;
  font-size: var(--jd-fs-sm);
  color: var(--jd-brand-deep);
}

.page .t-button {
  margin-top: 32rpx;
}

.page .t-button + .t-button {
  margin-top: 24rpx;
}
