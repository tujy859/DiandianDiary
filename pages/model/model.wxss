/* 模型配置页：字号/字色/圆角/线色全部走 app.wxss 设计令牌 */
.page {
  min-height: 100vh;
  padding: 32rpx var(--jd-page-gutter) calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.model-head { display:flex; align-items:center; gap:24rpx; padding:8rpx 0 16rpx; }
.model-brand { width:104rpx; height:104rpx; border-radius:30rpx; flex-shrink:0; }
.model-title { font-size:var(--jd-fs-xl); font-weight:600; color:var(--jd-text-1); }
.model-sub { font-size:var(--jd-fs-sm); color:var(--jd-text-2); margin-top:4rpx; }
.privacy-note, .connection-note { font-size:var(--jd-fs-xs); color:var(--jd-text-2); line-height:1.7; margin:24rpx 8rpx 0; }
.connection-note { text-align:center; margin-top:32rpx; }
.clear-action { margin-top:24rpx; text-align:center; }

.label {
  font-size: var(--jd-fs-sm);
  font-weight: 600;
  color: var(--jd-text-2);
  margin: 32rpx 8rpx 16rpx;
}

.provider-row {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

/* 供应商选择：全圆胶囊，选中态品牌绿 */
.provider-chip {
  font-size: var(--jd-fs-sm);
  padding: 12rpx 34rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid var(--jd-line);
  color: var(--jd-text-1);
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.provider-chip:active {
  transform: scale(0.97);
}

.provider-chip.is-active {
  background: var(--jd-brand);
  color: #ffffff;
  border-color: var(--jd-brand);
  font-weight: 600;
}

.panel {
  margin-top: 32rpx;
  padding: 12rpx 24rpx;
}

.panel .t-input {
  border-radius: var(--jd-r-sm);
  margin: 12rpx 0;
}

.default-link {
  margin-top: 24rpx;
  text-align: center;
  font-size: var(--jd-fs-sm);
  color: var(--jd-brand-deep);
}

.primary-action {
  margin-top: 32rpx;
}

.secondary-action {
  margin-top: 24rpx;
}
