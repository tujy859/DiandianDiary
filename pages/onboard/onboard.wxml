<view class="page">
  <offline-bar />
  <test-space-bar />
  <view wx:if="{{replay}}" class="replay-note">
    <view>引导演练 · 保留原登录和模型配置</view>
    <view class="replay-link" bindtap="onBackToTools">返回测试工具</view>
  </view>
  <view class="steps">
    <view class="step {{step === 'login' ? 'is-active' : 'is-done'}}">
      <view class="step-dot">1</view>
      <text class="step-text">连接云端</text>
    </view>
    <view class="step-line" />
    <view class="step {{step === 'model' ? 'is-active' : ''}}">
      <view class="step-dot">2</view>
      <text class="step-text">接入模型</text>
    </view>
  </view>

  <!-- 第一步：微信身份登录（静默，无授权弹窗） -->
  <block wx:if="{{step === 'login'}}">
    <view class="hero">
      <image class="hero-brand" src="/assets/brand/app-icon.png" mode="aspectFit" />
      <view class="hero-title">记一下喵</view>
      <view class="hero-sub">用聊天的方式，记下和小家伙的每一天</view>
    </view>

    <view class="jd-card panel">
      <view class="feature">
        <t-icon name="cloud" size="36rpx" color="#2F6B4F" />
        <text class="feature-text">日记保存在你的家庭空间，换设备也能看</text>
      </view>
      <view class="feature">
        <t-icon name="chat" size="36rpx" color="#2F6B4F" />
        <text class="feature-text">用微信身份登录，不需要注册账号</text>
      </view>
      <view class="feature">
        <t-icon name="chart-bubble" size="36rpx" color="#2F6B4F" />
        <text class="feature-text">接入模型后，聊聊天就能整理成待确认的日记</text>
      </view>
    </view>

    <view wx:if="{{error}}" class="error">
      <t-icon name="error-circle" size="32rpx" color="#D54941" />
      <text class="error-text">{{error}}</text>
    </view>

    <view class="actions">
      <t-button theme="primary" size="large" block shape="round" loading="{{busy}}" disabled="{{busy}}" bind:tap="onStart">连接云端，继续</t-button>
      <view class="next-note">首次使用：连接云端 → 接入模型 → 添加小伙伴</view>
    </view>
  </block>

  <!-- 第二步：选择云开发 AI 或自定义 API -->
  <block wx:else>
    <view class="hero is-model">
      <image class="hero-brand" src="/assets/brand/app-icon.png" mode="aspectFit" />
      <view class="hero-title">连接模型服务</view>
      <view class="hero-sub">用于理解聊天内容、整理日记和查询记录</view>
    </view>

    <view class="label">AI 服务来源</view>
    <view class="source-row">
      <view class="source-card {{source === 'cloud' ? 'is-active' : ''}}" data-source="cloud" bindtap="onSelectSource">
        <view class="source-name">微信云开发 AI</view>
        <view class="source-desc">无需填写地址和密钥</view>
      </view>
      <view class="source-card {{source === 'custom' ? 'is-active' : ''}}" data-source="custom" bindtap="onSelectSource">
        <view class="source-name">自定义 API</view>
        <view class="source-desc">自行填写地址和密钥</view>
      </view>
    </view>

    <block wx:if="{{source === 'cloud'}}">
      <view class="jd-card panel cloud-card">
        <view class="cloud-row"><view class="cloud-key">提供方</view><view class="cloud-val">微信云开发</view></view>
        <view class="cloud-row"><view class="cloud-key">模型</view><view class="cloud-val">{{cloudModel}}</view></view>
        <view class="cloud-row"><view class="cloud-key">额度</view><view class="cloud-val">以当前云环境为准</view></view>
      </view>
      <view wx:if="{{!cloudSupported}}" class="privacy-note">当前微信版本过低，云开发 AI 需要基础库 {{minSdk}} 以上。请升级微信，或改用自定义 API。</view>
    </block>

    <block wx:else>
      <view class="label">服务商</view>
      <view class="provider-row">
        <view
          wx:for="{{providers}}"
          wx:key="*this"
          class="provider-chip {{form.provider === item ? 'is-active' : ''}}"
          data-value="{{item}}"
          bindtap="onSelectProvider"
        >{{item}}</view>
      </view>

      <view class="jd-card panel">
        <t-input label="Base URL" placeholder="服务商提供的 API 地址" disabled="{{busy}}" value="{{form.baseUrl}}" bind:change="onBaseUrl" />
        <t-input label="API Key" type="password" placeholder="填写服务商提供的密钥" disabled="{{busy}}" value="{{form.apiKey}}" bind:change="onApiKey" />
        <t-input label="模型" placeholder="填写服务商提供的模型名" disabled="{{busy}}" value="{{form.model}}" bind:change="onModel" />
      </view>

      <view wx:if="{{recommendedModel}}" class="default-link" bindtap="onUseDefault">恢复默认地址和模型（{{recommendedModel}}）</view>
    </block>

    <view class="privacy-note">{{modelHelp}}</view>
    <view wx:if="{{replay}}" class="privacy-note">演练中填写的配置仅用于这次连接测试，不会保存。进入应用后继续使用原模型配置。</view>

    <view wx:if="{{error}}" class="error">
      <t-icon name="error-circle" size="32rpx" color="#D54941" />
      <text class="error-text">{{error}}</text>
    </view>

    <view class="actions">
      <t-button theme="primary" size="large" block shape="round" loading="{{busy}}" disabled="{{busy}}" bind:tap="onSaveModel">{{replay ? '测试填写的配置并继续' : '保存并测试连接'}}</t-button>
      <view wx:if="{{replay && hasSavedModel}}" class="secondary-action"><t-button theme="default" size="large" block shape="round" variant="outline" disabled="{{busy}}" bind:tap="onUseSavedModel">使用现有配置继续</t-button></view>
      <view wx:if="{{testFailed && !replay}}" class="secondary-action"><t-button theme="default" size="large" block shape="round" variant="outline" disabled="{{busy}}" bind:tap="onSkip">配置已保存，先进入</t-button></view>
      <view class="next-note">还没有宠物的话，接下来为小伙伴建个档案</view>
    </view>
  </block>

  <t-toast id="t-toast" />
</view>
