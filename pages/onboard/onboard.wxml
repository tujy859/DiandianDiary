<import src="../../templates/model-form.wxml" />
<view class="page">
  <offline-bar />
  <test-space-bar />
  <view wx:if="{{replay}}" class="replay-note">
    <view>引导演练 · 保留原登录和模型配置</view>
    <view class="replay-link" bindtap="onBackToTools">返回测试工具</view>
  </view>
  <view class="steps">
    <view class="step {{step === 'login' ? 'is-active' : 'is-done'}}">
      <view class="step-dot">1</view>
      <text class="step-text">连接云端</text>
    </view>
    <view class="step-line" />
    <view class="step {{step === 'model' ? 'is-active' : ''}}">
      <view class="step-dot">2</view>
      <text class="step-text">接入模型</text>
    </view>
  </view>

  <!-- 第一步：微信身份登录（静默，无授权弹窗） -->
  <block wx:if="{{step === 'login'}}">
    <view class="hero">
      <image class="hero-brand" src="/assets/brand/app-icon.png" mode="aspectFit" />
      <view class="hero-title">记一下喵</view>
      <view class="hero-sub">用聊天的方式，记下和小家伙的每一天</view>
    </view>

    <view class="jd-card panel">
      <view class="feature">
        <t-icon name="cloud" size="36rpx" color="#2F6B4F" />
        <text class="feature-text">日记保存在你的家庭空间，换设备也能看</text>
      </view>
      <view class="feature">
        <t-icon name="chat" size="36rpx" color="#2F6B4F" />
        <text class="feature-text">用微信身份登录，不需要注册账号</text>
      </view>
      <view class="feature">
        <t-icon name="chart-bubble" size="36rpx" color="#2F6B4F" />
        <text class="feature-text">接入模型后，聊聊天就能整理成待确认的日记</text>
      </view>
    </view>

    <view wx:if="{{error}}" class="error">
      <t-icon name="error-circle" size="32rpx" color="#D54941" />
      <text class="error-text">{{error}}</text>
    </view>

    <view class="actions">
      <t-button theme="primary" size="large" block shape="round" loading="{{busy}}" disabled="{{busy}}" bind:tap="onStart">连接云端，继续</t-button>
      <view class="next-note">首次使用：连接云端 → 接入模型 → 添加小伙伴</view>
    </view>
  </block>

  <!-- 第二步：选择云开发 AI 或自定义 API -->
  <block wx:else>
    <template is="model-form" data="{{source, providers, form, inputStyle, cloudModel, cloudSupported, minSdk, recommendedModel, modelHelp, locked: busy}}" />

    <view class="privacy-note">{{replay ? '演练中的改动仅用于测试；确认后继续使用已保存的正式配置。' : '测试连接只验证当前填写内容，确认后才保存配置并进入应用。'}}</view>
    <view wx:if="{{modelTest === 'success'}}" class="connection-success">连接成功，可以确认并继续。</view>

    <view wx:if="{{error}}" class="error">
      <t-icon name="error-circle" size="32rpx" color="#D54941" />
      <text class="error-text">{{error}}</text>
    </view>

    <view class="actions">
      <t-button theme="default" size="large" block shape="round" variant="outline" loading="{{testingModel}}" disabled="{{busy}}" bind:tap="onTestModel">测试连接</t-button>
      <view class="secondary-action"><t-button theme="primary" size="large" block shape="round" loading="{{busy && !testingModel}}" disabled="{{busy}}" bind:tap="onConfirmModel">确认并继续</t-button></view>
      <view class="next-note">还没有宠物的话，接下来为小伙伴建个档案</view>
    </view>
  </block>

  <t-toast id="t-toast" />
</view>
