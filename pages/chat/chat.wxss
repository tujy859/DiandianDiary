.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* 顶部宠物 */
.petbar {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 8rpx;
}

.pet-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 10rpx 28rpx;
  box-shadow: 0 2rpx 10rpx rgba(47, 107, 79, 0.08);
}

.pet-avatar {
  font-size: 36rpx;
}

.pet-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2b3a33;
}

/* 消息流 */
.msgs {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 8rpx 24rpx 0;
  overflow-x: hidden;
}

.msgs-pad {
  height: 24rpx;
}

.msg-row {
  width: 100%;
  box-sizing: border-box;
  margin: 16rpx 0;
}

.msg-row.is-user {
  display: flex;
  justify-content: flex-end;
}

.bubble {
  max-width: 78%;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
}

.bubble.is-user {
  background: #2f6b4f;
  border-bottom-right-radius: 8rpx;
}

.bubble.is-user .bubble-text {
  color: #ffffff;
}

.bubble.is-ai {
  background: #ffffff;
  border-bottom-left-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(47, 107, 79, 0.06);
}

.bubble-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #2b3a33;
  word-break: break-all;
  white-space: pre-wrap;
}

.bubble-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.bubble-photos:first-child {
  margin-top: 0;
}

.bubble-photo {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
}

.demo-tag {
  font-size: 20rpx;
  color: #b7a77a;
  margin: 6rpx 0 0 8rpx;
}

/* 查询引用卡 */
.ref-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
  background: #f2f7f4;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}

.ref-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.ref-label {
  font-size: 26rpx;
  color: #2f6b4f;
  font-weight: 600;
}

.ref-sub {
  font-size: 22rpx;
  color: #8a948e;
  margin-top: 2rpx;
}

.manual-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #2f6b4f;
  font-weight: 600;
  background: #e3efe8;
  padding: 10rpx 28rpx;
  border-radius: 32rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 48rpx 0;
  text-align: center;
}

.empty-emoji {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2b3a33;
}

.empty-desc {
  font-size: 26rpx;
  color: #8a948e;
  margin: 16rpx 0 32rpx;
}

/* 快捷入口 */
.quick {
  display: flex;
  gap: 20rpx;
  padding: 12rpx 24rpx;
}

.quick-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #2f6b4f;
  background: #ffffff;
  border: 1rpx solid #dcebe2;
  border-radius: 32rpx;
  padding: 10rpx 24rpx;
}

/* 输入区 */
.composer {
  background: #ffffff;
  border-top: 1rpx solid #eee6da;
  padding: 16rpx 24rpx;
}

.attach-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.attach-wrap {
  position: relative;
}

.attach-photo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

.attach-del {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
}

.input-row {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

.icon-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.input {
  flex: 1;
  min-width: 0;
  background: #f4f1ea;
  border-radius: 32rpx;
  padding: 18rpx 28rpx;
  font-size: 28rpx;
  max-height: 180rpx;
  min-height: 40rpx;
}

.input-placeholder {
  color: #a7b3ac;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #2f6b4f;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn.is-disabled {
  background: #b9cfc4;
}

.composer-tail {
  background: #ffffff;
}

/* 停止 / 重试 */
.stop-btn {
  margin: 12rpx 0 0 8rpx;
  font-size: 22rpx;
  color: #8a948e;
  border: 1rpx solid #dce4df;
  border-radius: 24rpx;
  padding: 6rpx 24rpx;
}

.retry-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin: 12rpx 0 0 8rpx;
  font-size: 24rpx;
  color: #2f6b4f;
  background: #e3efe8;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
}

/* 思考中 */
.typing {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx 28rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #a8d5ba;
  animation: typing-blink 1.2s infinite ease-in-out;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing-blink {
  0%, 60%, 100% { opacity: 0.3; }
  30% { opacity: 1; }
}

/* 欢迎区与输入区沿用统一的暖白、深绿和细线条。 */
.petbar { justify-content:flex-start; padding:20rpx 36rpx 8rpx; flex-shrink:0; }
.pet-chip { min-width:0; padding:8rpx 0; gap:12rpx; background:transparent; border-radius:0; box-shadow:none; }
.pet-avatar { display:block; width:64rpx; height:64rpx; padding:3rpx; border-radius:22rpx; background:#f2eee5; flex-shrink:0; }
.pet-name { max-width:400rpx; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.msgs { padding:8rpx 36rpx 0; }
.welcome { padding:38rpx 0 24rpx; }
.welcome-brand { width:144rpx; height:144rpx; border-radius:40rpx; margin-bottom:28rpx; }
.welcome-greeting { color:#78837b; font-size:24rpx; margin-bottom:8rpx; }
.welcome-title { color:#253a30; font-size:42rpx; font-weight:600; line-height:1.5; overflow-wrap:break-word; }
.welcome-desc { color:#78837b; font-size:25rpx; margin-top:12rpx; }
.quick-grid { display:flex; flex-wrap:wrap; gap:18rpx; margin-top:36rpx; }
.quick-tile { display:flex; flex-direction:column; width:calc((100% - 18rpx) / 2); padding:24rpx; border:1rpx solid #e9ece6; border-radius:28rpx; background:#ffffff; font-size:27rpx; }
.quick-tile > text { margin-top:12rpx; }
.quick-art { width:44rpx; height:44rpx; }
.quick-tile .quick-hint { color:#78837b; font-size:22rpx; margin-top:4rpx; }
.empty { padding:80rpx 24rpx 24rpx; }
.empty-brand { width:200rpx; height:200rpx; border-radius:52rpx; margin-bottom:28rpx; }
.bubble.is-user { background:#edf3ee; border:1rpx solid #dce6dc; }
.bubble.is-user .bubble-text { color:#253a30; }
.bubble.is-ai { border:1rpx solid #e9ece6; box-shadow:none; }
.composer { padding:16rpx 36rpx 0; background:#faf8f3; border-top:none; flex-shrink:0; }
.input-row { padding:10rpx 12rpx; gap:8rpx; align-items:center; background:#ffffff; border:1rpx solid #e9ece6; border-radius:44rpx; }
.icon-btn { width:52rpx; height:64rpx; flex-shrink:0; }
.input { background:transparent; border-radius:0; padding:10rpx 0; font-size:26rpx; }
.send-btn { width:64rpx; height:64rpx; flex-shrink:0; background:#32694f; }
.composer-tail { background:#faf8f3; }
.quick { padding:12rpx 36rpx; flex-shrink:0; }
.quick-chip { font-size:23rpx; padding:10rpx 20rpx; border-color:#e9ece6; }
.demo-tag { color:#78837b; }
@media (prefers-reduced-motion: reduce) { .typing-dot { animation:none; opacity:0.6; } }
