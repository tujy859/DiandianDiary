<view class="page">
  <view wx:if="{{!allowed}}" class="scope-note">开发者模式已关闭。请在「我的」点击 5 次「关于记一下喵」重新开启。</view>
  <block wx:else>
  <view class="sections">
    <view class="section {{section === 'core' ? 'active' : ''}}" data-section="core" bindtap="onSection">核心自检</view>
    <view class="section {{section === 'logs' ? 'active' : ''}}" data-section="logs" bindtap="onSection">执行日志</view>
  </view>
  <block wx:if="{{section === 'core'}}">
  <view class="scope-note">仅使用内存演示数据检查核心逻辑，不读写本机缓存，也不请求云端或模型。相同用例同时在自动化测试中运行。</view>
  <view class="lastrun">固定演示参考日期：{{referenceDate}}。通过不代表云端权限、真实模型或真机流程已验收。</view>
  <view class="summary">
    <view class="sum-item">
      <text class="sum-num is-pass">{{passed}}</text>
      <text class="sum-label">通过</text>
    </view>
    <view class="sum-item">
      <text class="sum-num is-fail">{{failed}}</text>
      <text class="sum-label">失败</text>
    </view>
    <t-button theme="primary" size="small" shape="round" loading="{{running}}" disabled="{{running}}" bind:tap="onRerun">重新运行</t-button>
  </view>

  <view wx:if="{{lastRunAt}}" class="lastrun">上次运行：{{lastRunAt}}（共 {{results.length}} 项）</view>
  <view wx:if="{{running}}" class="lastrun">运行中…</view>
  <view wx:if="{{!results.length && !running}}" class="lastrun">暂无结果</view>

  <view wx:for="{{results}}" wx:key="id" class="case {{item.pass ? 'is-pass' : 'is-fail'}}">
    <view class="case-head">
      <t-icon name="{{item.pass ? 'check-circle-filled' : 'close-circle-filled'}}" size="32rpx" color="{{item.pass ? '#2F6B4F' : '#D54941'}}" />
      <text class="case-name">{{item.name}}</text>
    </view>
    <view wx:if="{{item.detail}}" class="case-detail">{{item.detail}}</view>
  </view>
  </block>
  <block wx:if="{{section === 'logs'}}">
    <view class="scope-note">开启后记录当前家庭的聊天执行过程。仅在本机保留最近 12 次请求，每次最多 48 条事件，不采集密钥、聊天正文或照片。</view>
    <view class="log-actions">
      <t-button size="small" theme="primary" bind:tap="onToggleTrace">{{tracing ? '停止记录' : '开始记录'}}</t-button>
      <t-button size="small" bind:tap="onRefreshLogs">刷新日志</t-button>
      <t-button size="small" bind:tap="onCopyLogs">复制脱敏报告</t-button>
      <t-button size="small" variant="text" bind:tap="onClearLogs">清空日志</t-button>
    </view>
    <view wx:if="{{!traceRows.length}}" class="scope-note">暂无日志。开启记录后去「聊聊」发送消息，再回到这里查看。</view>
    <view wx:for="{{traceRows}}" wx:key="id" class="case">
      <view class="case-name">{{item.status}} · {{item.durationMs}}ms</view>
      <view class="case-detail">请求 {{item.id}}</view>
      <text class="trace-detail" selectable>{{item.detail}}</text>
    </view>
  </block>
  </block>
</view>
