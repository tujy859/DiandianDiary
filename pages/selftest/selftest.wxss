.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}
.scope-note { padding:24rpx; margin-bottom:20rpx; border-radius:16rpx; background:var(--jd-tint); color:var(--jd-text-2); font-size:24rpx; line-height:1.7; }
.sections { display:flex; gap:12rpx; margin-bottom:24rpx; }
.section { flex:1; min-width:0; padding:18rpx 4rpx; font-size:24rpx; text-align:center; border-radius:16rpx; color:var(--jd-text-2); background:#fff; }
.space-note { background:var(--jd-tint); border-radius:var(--jd-r-md); padding:24rpx; font-size:var(--jd-fs-md); word-break:break-all; }
.space-note.is-test { background:#fff6e5; }
.space-label, .space-sub { font-size:var(--jd-fs-xs); color:var(--jd-text-2); }
.space-sub { margin-top:8rpx; }
.tool-card { padding:28rpx; margin-top:24rpx; }
.tool-title { font-size:var(--jd-fs-lg); font-weight:600; color:var(--jd-text-1); }
.tool-desc, .foot-note { color:var(--jd-text-2); font-size:var(--jd-fs-sm); line-height:1.7; margin-top:12rpx; }
.tool-action { margin-top:24rpx; }
.foot-note { font-size:var(--jd-fs-xs); margin-top:28rpx; }
.family-link { color:var(--jd-brand); font-size:var(--jd-fs-sm); text-align:center; padding:24rpx 0; }
.section.active { color:var(--jd-brand); background:var(--jd-tint); font-weight:600; }
.log-actions { display:flex; flex-wrap:wrap; gap:16rpx; margin:24rpx 0; }
.trace-detail { display:block; white-space:pre-wrap; overflow-wrap:anywhere; font-size:22rpx; color:var(--jd-text-2); margin-top:16rpx; }

.summary {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.sum-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 48rpx;
}

.sum-num {
  font-size: 40rpx;
  font-weight: 700;
}

.sum-num.is-pass {
  color: #2f6b4f;
}

.sum-num.is-fail {
  color: #d54941;
}

.sum-label {
  font-size: 22rpx;
  color: #8a948e;
}

.lastrun {
  font-size: 22rpx;
  color: #8a948e;
  margin: 0 0 16rpx 8rpx;
}

.case {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border-left: 8rpx solid #c9cfcb;
}

.case.is-pass {
  border-left-color: #2f6b4f;
}

.case.is-fail {
  border-left-color: #d54941;
}

.case-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.case-name {
  font-size: 27rpx;
  color: #2b3a33;
}

.case-detail {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a948e;
  word-break: break-all;
}
