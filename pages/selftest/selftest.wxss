.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.summary {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.sum-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 48rpx;
}

.sum-num {
  font-size: 40rpx;
  font-weight: 700;
}

.sum-num.is-pass {
  color: #2f6b4f;
}

.sum-num.is-fail {
  color: #d54941;
}

.sum-label {
  font-size: 22rpx;
  color: #8a948e;
}

.lastrun {
  font-size: 22rpx;
  color: #8a948e;
  margin: 0 0 16rpx 8rpx;
}

.case {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border-left: 8rpx solid #c9cfcb;
}

.case.is-pass {
  border-left-color: #2f6b4f;
}

.case.is-fail {
  border-left-color: #d54941;
}

.case-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.case-name {
  font-size: 27rpx;
  color: #2b3a33;
}

.case-detail {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a948e;
  word-break: break-all;
}
