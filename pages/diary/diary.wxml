<test-space-bar />
<view wx:if="{{record}}" class="page">
  <view wx:if="{{loadError}}" class="jd-refresh-note">
    <text>刷新失败，正在显示已缓存的日记</text>
    <t-button size="small" variant="text" theme="primary" loading="{{refreshing}}" disabled="{{refreshing}}" bindtap="onRetry">重试</t-button>
  </view>
  <view class="jd-card card">
    <view class="head">
      <view class="pet"><image class="diary-avatar" src="{{record.petAvatar}}" mode="aspectFit" /><text>{{record.petName}}</text></view>
      <view class="date-wrap">
        <text class="date">{{record.dateText}}</text>
        <text class="rel">{{record.rel}}</text>
      </view>
    </view>

    <view wx:if="{{record.text}}" class="text">{{record.text}}</view>

    <view wx:if="{{record.photos.length}}" class="photos">
      <image
        wx:for="{{record.photos}}"
        wx:key="*this"
        class="photo"
        src="{{item}}"
        mode="aspectFill"
        lazy-load
        data-current="{{item}}"
        bindtap="onPreview"
      />
    </view>

    <view wx:if="{{record.tags.length}}" class="tags">
      <t-tag wx:for="{{record.tags}}" wx:key="*this" size="small" theme="primary" variant="light">{{item}}</t-tag>
    </view>
    <view wx:if="{{record.rawInput}}" class="original">
      <view class="original-toggle" bindtap="onToggleOriginal" aria-role="button" aria-expanded="{{originalExpanded}}">
        <text>{{originalExpanded ? '收起' : '查看'}}{{record.rawInput.provenance === 'legacy' ? '导入内容' : '原始输入'}}</text>
        <t-icon name="{{originalExpanded ? 'chevron-up' : 'chevron-down'}}" size="28rpx" color="#78837B" />
      </view>
      <view wx:if="{{originalExpanded}}" class="original-content">
        <view wx:if="{{record.rawInput.provenance === 'legacy'}}" class="original-note">旧记录导入内容（原始输入未留存）</view>
        <text selectable>{{record.rawInput.text || '（仅照片）'}}</text>
        <view wx:if="{{record.rawInput.photos.length}}">原始照片 {{record.rawInput.photos.length}} 张</view>
      </view>
    </view>
  </view>

  <view wx:if="{{canEdit}}" class="actions">
    <t-button theme="primary" size="large" block shape="round" icon="edit-1" bind:tap="onEdit">编辑</t-button>
    <view class="delete-btn" bindtap="onDelete">
      <t-icon name="delete" size="32rpx" color="#D54941" />
      <text>删除这条日记</text>
    </view>
  </view>

  <view wx:else class="original-note">仅日记作者或家庭创建者可编辑与删除</view>

  <draft-editor
    visible="{{editorVisible}}"
    value="{{editorValue}}"
    pets="{{pets}}"
    title="编辑日记"
    bind:confirm="onEditorConfirm"
    bind:close="onEditorClose"
  />
</view>

<view wx:elif="{{loading}}" class="missing">
  <view class="missing-text">加载中…</view>
</view>

<view wx:elif="{{loadError}}" class="missing">
  <t-icon name="cloud" size="64rpx" color="#78837B" />
  <view class="missing-text">暂时没能读取日记</view>
  <view class="missing-sub">{{loadError}}</view>
  <t-button theme="primary" size="medium" shape="round" loading="{{refreshing}}" disabled="{{refreshing}}" bindtap="onRetry">重新加载</t-button>
</view>

<view wx:else class="missing">
  <image class="missing-illustration" src="/assets/illustrations/missing-diary.png" mode="aspectFit" />
  <view class="missing-text">这条日记不存在或已被删除</view>
  <view class="missing-sub">回时光册看看其他回忆吧</view>
  <t-button theme="primary" size="medium" shape="round" bindtap="goAlbum">回时光册</t-button>
</view>

<t-dialog id="t-dialog" />
<t-toast id="t-toast" />
