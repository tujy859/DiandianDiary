/* 日记详情页：字号/字色/圆角/线色全部走 app.wxss 设计令牌 */
.page {
  min-height: 100vh;
  padding: 24rpx var(--jd-page-gutter) calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  padding: 32rpx;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--jd-line);
}

.pet {
  font-size: var(--jd-fs-lg);
  font-weight: 600;
  color: var(--jd-text-1);
}

.date-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.date {
  font-size: var(--jd-fs-sm);
  color: var(--jd-brand);
  font-weight: 600;
}

.rel {
  font-size: var(--jd-fs-xs);
  color: var(--jd-text-3);
  margin-top: 4rpx;
}

.text {
  font-size: var(--jd-fs-lg);
  line-height: 1.7;
  color: var(--jd-text-1);
  margin-top: 24rpx;
  /* 英文按词断行，不要 break-all 把单词从中间劈开 */
  overflow-wrap: break-word;
  word-break: normal;
  white-space: pre-wrap;
}

.photos {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.photo {
  width: 206rpx;
  height: 206rpx;
  border-radius: var(--jd-r-sm);
  background: var(--jd-tint);
}

.photo:only-child {
  width: 420rpx;
  height: 420rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}

.actions {
  margin-top: 48rpx;
}

.original { margin-top:32rpx; border-top:1rpx solid var(--jd-line); font-size:var(--jd-fs-sm); color:var(--jd-text-2); }
.original-toggle { display:flex; align-items:center; justify-content:space-between; gap:16rpx; min-height:44px; }
.original-toggle:active { color:var(--jd-brand); }
.original-content { padding-top:8rpx; white-space:pre-wrap; overflow-wrap:anywhere; }
.original-note { margin-bottom:12rpx; font-size:var(--jd-fs-xs); }

.delete-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 32rpx;
  font-size: var(--jd-fs-sm);
  color: var(--td-error-color);
  padding: 16rpx;
}

.missing {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 240rpx;
}

.missing-emoji {
  font-size: 88rpx;
}

.missing-illu {
  width: 320rpx;
  height: 296rpx;
  border-radius: 24rpx;
}

.missing-text {
  margin-top: 24rpx;
  font-size: var(--jd-fs-md);
  color: var(--jd-text-3);
}
.pet { display:flex; align-items:center; gap:12rpx; }
.diary-avatar { width:60rpx; height:60rpx; padding:3rpx; border-radius:20rpx; background:#f2eee5; }
.missing { padding:120rpx 36rpx 40rpx; }
.missing-illustration { width:320rpx; height:294rpx; border-radius:32rpx; }
.missing-sub { color:var(--jd-text-2); font-size:var(--jd-fs-sm); margin:12rpx 0 28rpx; padding:0 36rpx; word-break:break-word; }
