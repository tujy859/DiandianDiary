<view class="page" style="height: {{viewportHeight}}px; padding-bottom: {{tabbarHeight}}px;">
  <offline-bar />
  <test-space-bar />
  <!-- 头部：宠物 + 视角切换 -->
  <view class="header">
    <view wx:if="{{currentPet}}" class="pet-chip" bindtap="onSwitchPet">
      <image class="pet-avatar" src="{{petAvatar}}" mode="aspectFit" />
      <text class="pet-name">{{currentPet.name}}</text>
      <t-icon name="chevron-down" size="30rpx" color="#2F6B4F" />
    </view>
    <view class="seg">
      <view class="seg-item {{view === 'timeline' ? 'is-active' : ''}}" data-view="timeline" bindtap="onSwitchView">时间轴</view>
      <view class="seg-item {{view === 'gallery' ? 'is-active' : ''}}" data-view="gallery" bindtap="onSwitchView">画廊</view>
    </view>
  </view>

  <scroll-view scroll-y class="body" enhanced show-scrollbar="{{false}}">
    <view wx:if="{{loadError && records.length}}" class="jd-refresh-note">
      <text>刷新失败，正在显示已缓存的记录</text>
      <t-button size="small" variant="text" theme="primary" loading="{{refreshing}}" disabled="{{refreshing}}" bindtap="onRetry">重试</t-button>
    </view>
    <!-- 空状态 -->
    <view wx:if="{{loading && !records.length}}" class="empty">
      <view class="empty-text">正在翻开时光册…</view>
    </view>
    <view wx:elif="{{loadError && !records.length}}" class="empty">
      <t-icon name="cloud" size="64rpx" color="#78837B" />
      <view class="empty-text">暂时没能读取时光册</view>
      <view class="empty-sub">{{loadError}}</view>
      <t-button theme="primary" size="medium" shape="round" loading="{{refreshing}}" disabled="{{refreshing}}" bindtap="onRetry">重新加载</t-button>
    </view>
    <view wx:elif="{{!currentPet}}" class="empty">
      <image class="empty-illustration" src="/assets/brand/app-icon.png" mode="aspectFit" />
      <view class="empty-text">还没有小伙伴</view>
      <view class="empty-sub">先建个档案，再慢慢收集它的日常</view>
      <t-button theme="primary" size="medium" shape="round" bindtap="goAddPet">添加宠物</t-button>
    </view>
    <view wx:elif="{{!records.length}}" class="empty">
      <image class="empty-illustration" src="/assets/illustrations/empty-album.png" mode="aspectFit" />
      <view class="empty-text">还没有{{currentPet.name}}的日记</view>
      <view class="empty-sub">去「聊聊」记下第一件小事吧</view>
      <t-button theme="primary" size="medium" shape="round" bindtap="goChat">去聊聊</t-button>
    </view>

    <!-- 时间轴视角 -->
    <block wx:elif="{{view === 'timeline'}}">
      <view wx:for="{{records}}" wx:key="id" class="tl-item" data-id="{{item.id}}" bindtap="onOpenDiary">
        <view class="tl-dot-wrap">
          <view class="tl-dot"></view>
          <view class="tl-line" wx:if="{{index < records.length - 1}}"></view>
        </view>
        <view class="tl-card jd-card">
          <view class="tl-date-row">
            <text class="tl-date">{{item.dateText}}</text>
            <text class="tl-rel">{{item.rel}}</text>
          </view>
          <view wx:if="{{item.text}}" class="tl-text">{{item.text}}</view>
          <view wx:if="{{item.photos.length}}" class="tl-photos count-{{item.photos.length >= 4 ? 'multi' : item.photos.length}}">
            <image
              wx:for="{{item.photos}}"
              wx:for-item="p"
              wx:key="*this"
              class="tl-photo"
              src="{{p}}"
              mode="{{item.photos.length === 1 ? 'widthFix' : 'aspectFill'}}"
              data-urls="{{item.photos}}"
              data-current="{{p}}"
              catchtap="onPreviewPhoto"
            />
          </view>
          <view wx:if="{{item.tags.length}}" class="tl-tags">
            <t-tag wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this" size="small" theme="primary" variant="light">{{t}}</t-tag>
          </view>
        </view>
      </view>
    </block>

    <!-- 画廊视角 -->
    <block wx:else>
      <view wx:if="{{!gallery.length}}" class="empty">
        <image class="empty-illustration" src="/assets/illustrations/empty-gallery.png" mode="aspectFit" />
        <view class="empty-text">还没有{{currentPet.name}}的照片</view>
        <view class="empty-sub">去「聊聊」发张照片，留住一个小瞬间</view>
        <t-button theme="primary" size="medium" shape="round" bindtap="goChat">去发照片</t-button>
      </view>
      <view class="gallery">
        <view wx:for="{{gallery}}" wx:key="src" class="polaroid">
          <image
            class="polaroid-img"
            src="{{item.src}}"
            mode="aspectFill"
            lazy-load
            data-urls="{{item.urls}}"
            data-current="{{item.src}}"
            bindtap="onPreviewPhoto"
          />
          <view class="polaroid-foot">
            <text class="polaroid-date">{{item.dateText}}</text>
            <text class="polaroid-link" data-id="{{item.recordId}}" catchtap="onOpenDiary">日记</text>
          </view>
        </view>
      </view>
    </block>
    <view class="body-pad"></view>
  </scroll-view>

  <t-action-sheet id="t-action-sheet" bind:selected="onPetSelected" />
</view>
