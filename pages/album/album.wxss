.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx 12rpx;
}

.pet-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 8rpx 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(47, 107, 79, 0.08);
}

.pet-avatar {
  font-size: 32rpx;
}

.pet-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #2b3a33;
}

.seg {
  display: flex;
  background: #efe9df;
  border-radius: 36rpx;
  padding: 6rpx;
}

.seg-item {
  font-size: 26rpx;
  color: #8a948e;
  padding: 8rpx 32rpx;
  border-radius: 30rpx;
}

.seg-item.is-active {
  background: #2f6b4f;
  color: #ffffff;
  font-weight: 600;
}

.body {
  flex: 1;
  padding: 8rpx 24rpx 0;
}

.body-pad {
  height: 32rpx;
}

/* 时间轴 */
.tl-item {
  display: flex;
  margin-top: 20rpx;
}

.tl-dot-wrap {
  width: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  padding-top: 36rpx;
}

.tl-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #a8d5ba;
  border: 4rpx solid #e3efe8;
  flex-shrink: 0;
}

.tl-line {
  flex: 1;
  width: 2rpx;
  background: #e3efe8;
  margin-top: 8rpx;
}

.tl-card {
  flex: 1;
  padding: 24rpx;
  margin-bottom: 4rpx;
}

.tl-date-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.tl-date {
  font-size: 28rpx;
  font-weight: 600;
  color: #2f6b4f;
}

.tl-rel {
  font-size: 22rpx;
  color: #b7a77a;
}

.tl-text {
  font-size: 28rpx;
  color: #2b3a33;
  margin-top: 12rpx;
  word-break: break-all;
}

.tl-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tl-photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #f0ece4;
}

.tl-photos.count-1 .tl-photo {
  width: 320rpx;
  height: 320rpx;
}

.tl-photos.count-multi .tl-photo {
  width: 150rpx;
  height: 150rpx;
}

.tl-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

/* 画廊：克制的拍立得 */
.gallery {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding-top: 8rpx;
}

.polaroid {
  width: 340rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 16rpx 16rpx 12rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(47, 107, 79, 0.08);
}

.polaroid-img {
  width: 308rpx;
  height: 308rpx;
  border-radius: 8rpx;
  background: #f0ece4;
}

.polaroid-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 4rpx 0;
}

.polaroid-date {
  font-size: 22rpx;
  color: #8a948e;
}

.polaroid-link {
  font-size: 22rpx;
  color: #2f6b4f;
  font-weight: 600;
  padding: 4rpx 12rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 48rpx 0;
  text-align: center;
}

.empty-emoji {
  font-size: 88rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #2b3a33;
  font-weight: 500;
}

.empty-sub {
  font-size: 24rpx;
  color: #8a948e;
  margin: 12rpx 0 32rpx;
}
