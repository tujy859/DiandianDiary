.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #faf7f0;
}

/* 头部：宠物徽章（样式在 app.wxss 全局共享，与聊聊完全一致）+ 视角切换 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* 与聊聊页浮动徽章的 top/left 完全同位 */
  padding: 20rpx 28rpx 12rpx;
}

/* 视角切换：中性轨道 + 品牌绿选中块 */
.seg {
  display: flex;
  background: rgba(31, 43, 37, 0.06);
  border-radius: 999rpx;
  padding: 6rpx;
}

.seg-item {
  font-size: var(--jd-fs-sm);
  color: var(--jd-text-2);
  padding: 10rpx 30rpx;
  border-radius: 999rpx;
  transition: all 0.2s ease;
}

.seg-item.is-active {
  background: var(--jd-brand);
  color: #ffffff;
  font-weight: 600;
}

.body {
  flex: 1;
  padding: 12rpx 28rpx 0;
}

.body-pad {
  height: 32rpx;
}

/* 时间轴 */
.tl-item {
  display: flex;
  margin-top: 20rpx;
}

.tl-dot-wrap {
  width: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
  padding-top: 36rpx;
}

.tl-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--jd-brand);
  border: 4rpx solid var(--jd-tint);
  flex-shrink: 0;
}

.tl-line {
  flex: 1;
  width: 2rpx;
  background: var(--jd-tint);
  margin-top: 8rpx;
}

.tl-card {
  flex: 1;
  padding: 26rpx;
  margin-bottom: 4rpx;
}

.tl-date-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.tl-date {
  font-size: var(--jd-fs-md);
  font-weight: 600;
  color: var(--jd-brand);
}

.tl-rel {
  font-size: var(--jd-fs-xs);
  color: var(--jd-text-3);
}

.tl-text {
  font-size: var(--jd-fs-lg);
  line-height: 1.66;
  color: var(--jd-text-1);
  margin-top: 12rpx;
  overflow-wrap: break-word;
  word-break: normal;
}

.tl-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tl-photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--jd-r-sm);
  background: #f0ece4;
}

.tl-photos.count-1 .tl-photo {
  width: 320rpx;
  height: 320rpx;
}

.tl-photos.count-multi .tl-photo {
  width: 150rpx;
  height: 150rpx;
}

.tl-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

/* 画廊：克制的拍立得 */
.gallery {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding-top: 8rpx;
}

.polaroid {
  width: 340rpx;
  background: #ffffff;
  border-radius: var(--jd-r-sm);
  padding: 16rpx 16rpx 14rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(47, 107, 79, 0.08);
}

.polaroid-img {
  width: 308rpx;
  height: 308rpx;
  border-radius: 12rpx;
  background: #f0ece4;
}

.polaroid-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 4rpx 0;
}

.polaroid-date {
  font-size: var(--jd-fs-xs);
  color: var(--jd-text-3);
}

.polaroid-link {
  font-size: var(--jd-fs-sm);
  color: var(--jd-brand);
  font-weight: 600;
  padding: 4rpx 12rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 140rpx 48rpx 0;
  text-align: center;
}

.empty-emoji {
  font-size: 88rpx;
  margin-bottom: 24rpx;
}

.empty-illu {
  width: 320rpx;
  height: 296rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
}

.empty-text {
  font-size: var(--jd-fs-md);
  color: var(--jd-text-1);
  font-weight: 500;
}

.empty-sub {
  font-size: var(--jd-fs-sm);
  color: var(--jd-text-2);
  margin: 12rpx 0 36rpx;
}
