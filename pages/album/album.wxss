.page { display:flex; flex-direction:column; overflow:hidden; }
.header { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:24rpx 36rpx 16rpx; flex-shrink:0; }
.pet-chip { display:flex; align-items:center; gap:12rpx; min-width:0; padding:8rpx 0; }
.pet-avatar { width:64rpx; height:64rpx; border-radius:22rpx; background:#f2eee5; flex-shrink:0; padding:3rpx; }
.pet-name { font-size:28rpx; font-weight:600; color:#253a30; max-width:210rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.seg { display:flex; flex-shrink:0; background:#efeee8; padding:6rpx; border-radius:24rpx; }
.seg-item { color:#78837b; font-size:24rpx; padding:8rpx 20rpx; border-radius:18rpx; }
.seg-item.is-active { background:#ffffff; color:#32694f; font-weight:600; }
.body { flex:1; min-height:0; width:100%; padding:8rpx 36rpx 0; }
.body-pad { height:40rpx; }
.tl-item { display:flex; margin-top:24rpx; }
.tl-dot-wrap { position:relative; width:32rpx; flex-shrink:0; }
.tl-dot { position:absolute; top:32rpx; left:0; width:14rpx; height:14rpx; border-radius:50%; background:#32694f; box-shadow:0 0 0 6rpx #faf8f3; z-index:1; }
.tl-line { position:absolute; top:39rpx; bottom:-63rpx; left:6rpx; width:2rpx; background:#dce6dc; }
.tl-card { flex:1; min-width:0; padding:28rpx; }
.tl-date-row { display:flex; justify-content:space-between; align-items:baseline; gap:12rpx; }
.tl-date { color:#32694f; font-size:25rpx; font-weight:600; }
.tl-rel { color:#78837b; font-size:22rpx; flex-shrink:0; }
.tl-text { color:#253a30; font-size:28rpx; line-height:1.7; margin-top:18rpx; white-space:pre-wrap; word-break:break-all; }
.tl-photos { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:20rpx; }
.tl-photo { width:calc((100% - 12rpx) / 2); height:240rpx; border-radius:20rpx; background:#efeee8; }
.tl-photos.count-1 .tl-photo { width:100%; height:auto; }
.tl-photos.count-multi .tl-photo { width:calc((100% - 24rpx) / 3); height:168rpx; }
.tl-tags { display:flex; flex-wrap:wrap; gap:10rpx; margin-top:18rpx; }
.gallery { display:flex; flex-wrap:wrap; justify-content:space-between; }
.polaroid { width:calc((100% - 20rpx) / 2); padding:12rpx; margin-top:20rpx; border-radius:22rpx; background:#ffffff; border:1rpx solid #e9ece6; }
.polaroid-img { display:block; width:100%; height:280rpx; border-radius:14rpx; background:#efeee8; }
.polaroid-foot { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:6rpx; padding:12rpx 2rpx 0; }
.polaroid-date { color:#78837b; font-size:22rpx; }
.polaroid-link { color:#32694f; font-size:22rpx; padding:8rpx; }
.empty { display:flex; flex-direction:column; align-items:center; text-align:center; padding:90rpx 24rpx 40rpx; }
.empty-brand { width:280rpx; height:280rpx; border-radius:72rpx; overflow:hidden; flex-shrink:0; margin-bottom:28rpx; }
.empty-brand-image { display:block; width:100%; height:100%; }
.empty-illustration { width:300rpx; height:280rpx; border-radius:32rpx; margin-bottom:28rpx; }
.empty-text { color:#253a30; font-size:28rpx; font-weight:500; }
.empty-sub { color:#78837b; font-size:24rpx; margin:12rpx 0 32rpx; }
