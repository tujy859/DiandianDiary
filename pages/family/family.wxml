<view class="page">
  <offline-bar />
  <test-space-bar />
  <view class="hero">
    <view class="hero-title">一起记下它的日常</view>
    <view class="hero-sub">加入同一家庭，和家人一起查看宠物与日记。</view>
  </view>
  <view wx:if="{{error}}" class="error">
    <t-icon name="error-circle" size="32rpx" color="#D54941" />
    <text class="error-text">{{error}}</text>
  </view>
  <view wx:if="{{!connected}}" class="jd-card panel connect">
    <view class="connect-icon">
      <t-icon name="usergroup" size="56rpx" color="#2F6B4F" />
    </view>
    <view class="connect-title">云端连接已断开</view>
    <view class="connect-sub">重新连接后，可以查看和管理家庭空间。</view>
    <t-button class="connect-btn" theme="primary" size="large" block shape="round" loading="{{busy}}" disabled="{{busy}}" bind:tap="onConnect">重新连接云端</t-button>
  </view>
  <block wx:if="{{connected}}">
    <view class="section-title">当前家庭</view>
    <view wx:if="{{!familyId}}" class="jd-card panel empty-family">
      <t-icon name="usergroup" size="56rpx" color="#78837B" />
      <view class="connect-title">还没有家庭空间</view>
      <view class="note-line">创建一个家庭，或用邀请码加入家人的空间，就能继续记录。</view>
    </view>
    <view wx:else class="jd-card panel current-family">
      <view class="family-heading">
        <view class="family-heading-main">
          <view class="family-title">{{selectedFamilyName}}</view>
          <view class="family-caption">{{members.length}} 位成员 · 我是{{owner ? '创建者' : '成员'}}</view>
        </view>
        <view wx:if="{{families.length > 1}}" class="text-entry" data-section="families" bindtap="onToggleSection" aria-role="button" aria-label="切换家庭">切换家庭</view>
      </view>
      <view wx:if="{{expandedSection === 'families'}}" class="family-options">
        <view wx:for="{{families}}" wx:key="id" class="fam-row {{item.id === familyId ? 'is-active' : ''}}" data-id="{{item.id}}" bindtap="onSwitch">
          <t-icon name="{{item.id === familyId ? 'check-circle-filled' : 'circle'}}" size="36rpx" color="{{item.id === familyId ? '#2F6B4F' : '#C9CFCC'}}" />
          <text class="fam-name">{{item.name}}</text>
          <text wx:if="{{item.id === familyId}}" class="fam-tag">当前</text>
        </view>
      </view>
      <view class="member-preview" wx:if="{{expandedSection !== 'management'}}">
        <block wx:for="{{members}}" wx:key="userId">
          <view class="member" wx:if="{{index < 3}}">
            <view class="member-avatar">
              <t-icon name="user" size="32rpx" color="#2F6B4F" />
            </view>
            <view class="member-info">
              <text class="member-name">{{item.label}}</text>
              <text class="member-role">{{item.role === 'owner' ? '创建者' : '成员'}}</text>
            </view>
          </view>
        </block>
        <view wx:if="{{members.length > 3}}" class="text-entry" data-section="management" bindtap="onToggleSection">查看全部 {{members.length}} 位成员</view>
      </view>
      <view class="card-actions">
        <t-button wx:if="{{owner && !inviteToken}}" block theme="primary" variant="outline" shape="round" disabled="{{busy}}" bind:tap="onInvite">邀请家人</t-button>
        <t-button wx:if="{{needsContinue}}" theme="primary" block shape="round" disabled="{{busy}}" bind:tap="onContinue">继续使用</t-button>
      </view>
      <view wx:if="{{inviteToken}}" class="invite">
        <view class="invite-label">邀请码（{{inviteExpiry}}）</view>
        <text class="invite-code" selectable user-select>{{inviteToken}}</text>
        <view class="invite-actions">
          <t-button size="small" theme="primary" shape="round" bind:tap="onCopy">复制邀请码</t-button>
          <t-button size="small" theme="danger" variant="text" disabled="{{busy}}" bind:tap="onRevoke">撤销</t-button>
        </view>
      </view>
      <view class="disclosure-row management-entry" data-section="management" bindtap="onToggleSection" aria-role="button" aria-expanded="{{expandedSection === 'management'}}">
        <text class="disclosure-title">家庭管理</text>
        <t-icon name="{{expandedSection === 'management' ? 'chevron-up' : 'chevron-down'}}" size="30rpx" color="#78837B" />
      </view>
      <view wx:if="{{expandedSection === 'management'}}" class="management-content">
        <view class="member" wx:for="{{members}}" wx:key="userId">
          <view class="member-avatar">
            <t-icon name="user" size="32rpx" color="#2F6B4F" />
          </view>
          <view class="member-info">
            <text class="member-name">{{item.label}}</text>
            <text class="member-role">{{item.role === 'owner' ? '创建者' : '成员'}}</text>
          </view>
          <view wx:if="{{owner && item.role !== 'owner'}}" class="member-del" data-id="{{item.userId}}" catchtap="onRemove" aria-role="button" aria-label="移除成员 {{item.label}}">
            <t-icon name="delete" size="36rpx" color="#78837B" />
          </view>
        </view>
        <view class="family-management">
          <view class="note-line">{{owner ? '解散后所有成员将失去访问权限。云端数据暂时保留，不会永久删除，暂不支持恢复。' : '退出只影响你，曾保存的日记仍留在家庭中。'}}</view>
          <t-button wx:if="{{owner}}" theme="danger" variant="text" disabled="{{busy}}" bind:tap="onDissolve">解散家庭</t-button>
          <t-button wx:else theme="danger" variant="text" disabled="{{busy}}" bind:tap="onLeave">退出家庭</t-button>
        </view>
      </view>
    </view>
    <view class="jd-card panel settings-panel">
      <view class="disclosure-row" data-section="spaces" bindtap="onToggleSection" aria-role="button" aria-expanded="{{!familyId || expandedSection === 'spaces'}}">
        <view class="disclosure-main">
          <view class="disclosure-title">加入或创建家庭</view>
          <view class="disclosure-sub">{{families.length ? '已加入 ' + families.length + ' 个家庭' : '开始和小伙伴的记录'}}</view>
        </view>
        <t-icon name="{{!familyId || expandedSection === 'spaces' ? 'chevron-up' : 'chevron-down'}}" size="30rpx" color="#78837B" />
      </view>
      <view wx:if="{{!familyId || expandedSection === 'spaces'}}" class="disclosure-content">
        <view class="field-label">加入家人的空间</view>
        <t-input placeholder="粘贴家人提供的邀请码" maxlength="48" value="{{inviteInput}}" bind:change="onInviteInput" />
        <t-button class="action-btn" theme="primary" block shape="round" disabled="{{busy || !inviteInput}}" bind:tap="onJoin">加入家庭</t-button>
        <view class="divider">
          <view class="divider-line" />
          <text class="divider-text">或</text>
          <view class="divider-line" />
        </view>
        <view class="field-label">创建新家庭</view>
        <t-input placeholder="给家庭起个名字" maxlength="40" value="{{familyName}}" bind:change="onFamilyName" />
        <t-button class="action-btn" theme="primary" block shape="round" disabled="{{busy || !familyName}}" bind:tap="onCreate">创建家庭空间</t-button>
        <view class="note-line">最多加入 10 个家庭；退出或解散后会释放名额。</view>
      </view>
    </view>
  </block>
  <view wx:if="{{loggedIn}}" class="jd-card panel settings-panel">
    <view class="disclosure-row" data-section="account" bindtap="onToggleSection" aria-role="button" aria-expanded="{{expandedSection === 'account'}}">
      <view class="disclosure-main">
        <view class="disclosure-title">账号设置</view>
        <view class="disclosure-sub">昵称与本机登录</view>
      </view>
      <t-icon name="{{expandedSection === 'account' ? 'chevron-up' : 'chevron-down'}}" size="30rpx" color="#78837B" />
    </view>
    <view wx:if="{{expandedSection === 'account'}}" class="disclosure-content">
      <block wx:if="{{connected}}">
        <t-input label="昵称" type="nickname" placeholder="选填，仅用于展示" maxlength="40" value="{{nickname}}" bind:change="onNickname" />
        <t-button class="save-btn" theme="primary" block shape="round" disabled="{{busy}}" bind:tap="onSaveProfile">保存昵称</t-button>
      </block>
      <view class="logout-content">
        <view class="note-line">仅退出本机登录，云端日记和家庭关系保留。</view>
        <view class="logout-option">
          <text>同时清除本机模型配置</text>
          <switch checked="{{clearModelOnLogout}}" color="#32694F" disabled="{{busy}}" bindchange="onLogoutModelChange" aria-label="同时清除本机模型配置" />
        </view>
        <t-button block theme="danger" variant="outline" shape="round" disabled="{{busy}}" bind:tap="onLogout">退出登录</t-button>
      </view>
    </view>
  </view>
  <view wx:if="{{connected}}" class="footer-actions">
    <t-button block theme="default" variant="text" disabled="{{busy}}" bind:tap="onConnect">刷新云端数据</t-button>
  </view>
  <view wx:if="{{busy}}" class="busy-note">正在连接或保存，请稍候…</view>
  <view class="foot-note">家庭空间的日记保存在云端，换设备登录后仍可查看。</view>
  <t-dialog id="t-dialog" />
</view>
