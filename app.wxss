/* 记一下喵 全局主题：暖白底 / 翡翠森绿 / 薄荷绿辅助 / 暖阳杏橙，统一覆盖 TDesign 令牌 */
page {
  background: #faf8f3;
  color: #253a30;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;

  /* 自定义 tabBar 内容高度（rpx），与 utils/layout.ts 的测量口径保持一致 */
  --jd-tabbar-content: 112;
  --jd-tabbar-label-size: 12px;

  /* ---- 设计令牌：全app统一的字号/字色/圆角/线色，新增样式只允许从这里取值 ---- */
  /* 字号六级：标注 / 辅助 / 列表 / 正文 / 标题 / 大标题 */
  --jd-fs-xs: 22rpx;
  --jd-fs-sm: 26rpx;
  --jd-fs-md: 28rpx;
  --jd-fs-lg: 30rpx;
  --jd-fs-xl: 34rpx;
  --jd-fs-xxl: 42rpx;
  /* 文字三级：主 / 次 / 弱（暖底上要够黑够脆，避免发闷） */
  --jd-text-1: #253a30;
  --jd-text-2: #78837b;
  --jd-text-3: #97a39c;
  /* 全app唯一细线色 */
  --jd-line: rgba(31, 43, 37, 0.08);
  /* 品牌绿与淡绿辅助面 */
  --jd-brand: #32694f;
  --jd-brand-deep: #245e41;
  --jd-tint: #edf4ef;
  --jd-bg: #faf8f3;
  --jd-page-gutter: 36rpx;
  --jd-pet-toolbar-gutter: 32rpx;
  --jd-pet-toolbar-top: 20rpx;
  --jd-pet-chip-size: 32px;
  /* 圆角三档 + 全圆 */
  --jd-r-sm: 16rpx;
  --jd-r-md: 24rpx;
  --jd-r-lg: 32rpx;

  /* TDesign 主题令牌覆盖 */
  --td-brand-color: var(--jd-brand);
  --td-brand-color-hover: #337655;
  --td-brand-color-active: #1e5039;
  --td-brand-color-disabled: #b6ccbf;
  --td-brand-color-focus: rgba(37, 97, 69, 0.12);
  --td-brand-color-light: #e6f2eb;
  --td-brand-color-light-hover: #d5e8dd;
  --td-success-color: #52af87;
  --td-warning-color: #f2a65a;
  --td-error-color: #d54941;
  --td-bg-color-page: var(--jd-bg);
  --td-bg-color-container: #ffffff;
  --td-text-color-primary: var(--jd-text-1);
  --td-text-color-secondary: var(--jd-text-2);
  --td-text-color-placeholder: #a1ada6;
  --td-radius-medium: 18rpx;
  --td-radius-large: 28rpx;
}

view,
text,
textarea,
input,
button,
scroll-view {
  box-sizing: border-box;
}

/* 两页共享顶部间距；视觉按钮与宽松点击区域分开，头像与外框等高。 */
.pet-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: var(--jd-pet-toolbar-top) var(--jd-pet-toolbar-gutter) 16rpx;
  flex-shrink: 0;
}

.pet-switch {
  display: flex;
  align-items: center;
  min-width: 0;
  min-height: 44px;
  flex-shrink: 1;
}

.pet-chip {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
  max-width: 100%;
  height: var(--jd-pet-chip-size);
  padding: 0 12rpx 0 0;
  background: #ffffff;
  border-radius: 999rpx;
  overflow: hidden;
}

.pet-chip::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border: 1rpx solid #e9ece6;
  border-radius: inherit;
  pointer-events: none;
}

.pet-switch:active .pet-chip {
  transform: scale(0.97);
}

.pet-avatar {
  font-size: var(--jd-fs-xl);
}

.pet-name {
  font-size: var(--jd-fs-md);
  font-weight: 600;
  color: var(--jd-text-1);
}

.pet-chip .pet-avatar {
  box-sizing: border-box;
  display: block;
  width: var(--jd-pet-chip-size);
  height: var(--jd-pet-chip-size);
  padding: 3px;
  border: 1rpx solid #e9ece6;
  border-radius: 50%;
  background: #ffffff;
  flex-shrink: 0;
}

.pet-chip .pet-name {
  min-width: 0;
  max-width: 210rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 轻量白底卡片，主要依靠细边框区分层次 */
.jd-card {
  background: #ffffff;
  border-radius: 28rpx;
  border: 1rpx solid rgba(240, 236, 228, 0.85);
  box-shadow: 0 2rpx 8rpx rgba(47, 107, 79, 0.03);
}

/* 页面骨架：底部留白统一交给 tabBar 占位变量，避免各页各写一套 */
.jd-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  overflow-x: hidden;
  background: var(--jd-bg);
}

/* 滚动区域收尾留白 */
.jd-scroll-tail {
  height: 40rpx;
}

/* 有缓存时继续展示内容，持续提示刷新失败并给出重试入口。 */
.jd-refresh-note {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  margin: 12rpx 0;
  border-radius: var(--jd-r-sm);
  background: #fff6e5;
  font-size: var(--jd-fs-xs);
  color: #8a5a00;
}

/* 暖阳杏橙微小圆点装饰 */
.jd-dot {
  display: inline-block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #f2a65a;
}

