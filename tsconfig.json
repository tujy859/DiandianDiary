{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strictNullChecks": true,
    "noImplicitAny": false,
    "removeComments": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "tdesign-miniprogram/*": ["miniprogram_npm/tdesign-miniprogram/*"]
    },
    "lib": ["ES2020"]
  },
  "exclude": ["node_modules", "tools", "tools/node_modules", "cloudfunctions"]
}
